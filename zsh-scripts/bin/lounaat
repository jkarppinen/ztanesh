#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx", "beautifulsoup4", "rich", "requests"]
# ///

import requests
from bs4 import BeautifulSoup
from dataclasses import dataclass, field
from typing import List, Optional
from rich import print
from rich.console import Console
from rich.text import Text
import argparse
import re
from datetime import datetime, timedelta

@dataclass
class MenuLine:
    dish: str
    price: Optional[str] = None
    diet_tags: List[str] = field(default_factory=list)

@dataclass
class LunchItem:
    name: str
    lines: List[MenuLine]
    external_link: Optional[str] = None
    distance_m: int = 0
    lunch_time: Optional[str] = None
    distance_is_walking: bool = False

COOKIES = {
    "location_v2": '{"lat":"65.01099","lng":"25.47689","formattedAddress":"Mäkelininkatu+31, Oulu"}',
    "layout_v2": '"rivit"',
    "view_v2": '"lahistolla"',
    "search_v2": '"sijainti"',
    "showempty_v2": '"no"',
}

HEADERS = {
    "User-Agent": "Mozilla/5.0",
    "X-Requested-With": "XMLHttpRequest",
    "Accept": "*/*",
    "Referer": "https://www.lounaat.info/",
}

BASE_URL = "https://www.lounaat.info/ajax/filter"

# Walking distances in meters from Mäkelininkatu 31, Oulu
# Source: Google Maps walking directions, 2026-03-12
WALKING_DISTANCES = {
    "Alfred Kitchen & Bar": 73,
    "Little New York": 136,
    "The Flying Bull": 125,
    "Ravintola Gaia": 202,
    "Gaia": 202,
    "Grill It! Oulu": 290,
    "Cafe Mallaamo": 271,
    "La Torrefazione": 250,
    "Ravintola Pekuri": 565,
    "Ravintola Sarkka": 293,
    "Rosso Oulu": 250,
    "Sauraha": 348,
    "Frans & Camille Oulu": 415,
    "Ravintola Puistola": 418,
    "Amarillo Oulu": 500,
    "Ravintola Pannu": 435,
    "Food & Co Kantakortteli": 522,
    "Antell Piha": 565,
    "Valveen Paljetti": 545,
    "Cafe Rooster": 637,
    "Food & Co MIN Ydinkeskusta": 685,
    "Kauppuri 5 Burgers": 606,
    "Pancho Villa Oulu Keskusta": 573,
    "Tuba": 792,
    "Restaurant Ule": 931,
    "Voimala 1889": 904,
    "Teatteriravintola Aulis": 830,
    "Opetusravintola Hilikku": 1100,
    "De Gamlas Hem": 1300,
    "Huovisen leipomo - Iso-Ilmari": 1200,
    "Lasaretti": 1400,
    "Makujen Paljetti": 1800,
}

DIET_COLOURS = {
    "l": ("L", "yellow"),
    "g": ("G", "green"),
    "m": ("M", "red"),
    "vl": ("VL", "orange1"),
    "veg": ("VEG", "bright_green"),
    "v": ("V", "bright_cyan"),
}

WEEKDAYS = ["maanantai", "tiistai", "keskiviikko", "torstai", "perjantai", "lauantai", "sunnuntai"]

def parse_distance(text: str) -> int:
    return int(float(text.replace("km", "").strip()) * 1000) if "km" in text else int(text.replace("m", "").strip())

def extract_diets(tag: BeautifulSoup) -> List[str]:
    return [a["href"].strip("#").lower() for a in tag.select("a.diet")]

def fetch_lunch_items(max_distance: int, weekday: Optional[int] = None) -> List[LunchItem]:
    results: List[LunchItem] = []

    # lounaat.info uses 1-7 for Mon-Sun
    if weekday is not None:
        day_param = str(weekday)
    else:
        current_day = datetime.now().weekday()
        if current_day < 5:  # Monday to Friday
            day_param = str(current_day + 1)
        else:  # Saturday or Sunday - default to Monday
            day_param = "1"

    for page in range(4):
        params = {
            "view": "lahistolla",
            "day": day_param,
            "page": str(page),
            "coords": "false",
        }

        resp = requests.get(BASE_URL, headers=HEADERS, cookies=COOKIES, params=params)
        resp.raise_for_status()
        soup = BeautifulSoup(resp.text, "html.parser")

        for r in soup.select("div.menu.item"):
            name_tag = r.select_one("h3 a")
            if not name_tag:
                continue
            name = name_tag.text.strip()

            dist_tag = r.select_one("div.item-footer p.dist")
            if not dist_tag:
                continue
            distance_m = parse_distance(dist_tag.text.strip())

            lunch_time_tag = r.select_one("p.lunch:not(.closed)")
            lunch_time = None
            if lunch_time_tag:
                match = re.search(r"\d{1,2}[:.]?\d{0,2}\s*[-–]\s*\d{1,2}[:.]?\d{0,2}", lunch_time_tag.text)
                if match:
                    lunch_time = match.group(0).replace(".", ":").replace("–", "-").replace(" ", "")

            external_link = None
            lines: List[MenuLine] = []

            link_tag = r.select_one("div.item-body a.missing")
            if link_tag:
                external_link = link_tag.get("href")
            else:
                for li in r.select("li.menu-item"):
                    dish_tag = li.select_one("p.dish")
                    if not dish_tag:
                        continue
                    dish_text = dish_tag.get_text(strip=True)
                    diet_keys = extract_diets(dish_tag)
                    price_tag = li.select_one("p.price")
                    price = price_tag.get_text(strip=True) if price_tag else None
                    lines.append(MenuLine(dish=dish_text, price=price, diet_tags=diet_keys))

            walking_dist = WALKING_DISTANCES.get(name)
            if walking_dist is not None:
                effective_distance = walking_dist
                is_walking = True
            else:
                effective_distance = distance_m
                is_walking = False

            if effective_distance > max_distance:
                continue

            results.append(LunchItem(
                name=name,
                lines=lines,
                external_link=external_link,
                distance_m=effective_distance,
                lunch_time=lunch_time,
                distance_is_walking=is_walking,
            ))

    return sorted(results, key=lambda x: x.distance_m)

def format_diet_tags(tags: List[str]) -> List[Text]:
    parts = []
    for tag in tags:
        label, colour = DIET_COLOURS.get(tag.lower(), (tag.upper(), "white"))
        parts.append(Text(f" {label}", style=colour))
    return parts

import os
import subprocess
import sys
from contextlib import contextmanager

@contextmanager
def maybe_pager():
    if sys.stdout.isatty():
        proc = subprocess.Popen(["less", "-FRX"], stdin=subprocess.PIPE, text=True)
        try:
            with proc.stdin as pipe:
                yield pipe
        finally:
            proc.wait()
    else:
        yield sys.stdout

def print_lunches(lunches: List[LunchItem], requested_weekday: Optional[int] = None):
    with maybe_pager() as output:
        console = Console(file=output, force_terminal=True, color_system="truecolor")

        now = datetime.now()
        date_str = now.strftime("%-d.%-m.%Y")

        if requested_weekday is not None:
            requested_day_name = WEEKDAYS[requested_weekday - 1]
            days_diff = (requested_weekday - 1) - now.weekday()
            target_date = now + timedelta(days=days_diff)
            target_date_str = target_date.strftime("%-d.%-m.")
            console.print(f"[bold yellow]Lounaslista: {requested_day_name} {target_date_str}[/bold yellow]\n")
        elif now.weekday() >= 5:  # Saturday or Sunday
            weekday = WEEKDAYS[now.weekday()]
            console.print(f"[bold yellow]{weekday.capitalize()} {date_str} - Lounaslista: maanantai[/bold yellow]\n")
        else:
            weekday = WEEKDAYS[now.weekday()]
            console.print(f"[bold yellow]{weekday.capitalize()} {date_str}[/bold yellow]\n")

        for lunch in lunches:
            dist_label = f"{lunch.distance_m} m" if lunch.distance_is_walking else f"~{lunch.distance_m} m"
            header = Text(f"{lunch.name} (", style="bold blue")
            if lunch.distance_is_walking:
                header.append(f"🚶{dist_label}", style="bold green")
            else:
                header.append(dist_label, style="bold yellow")
            header.append(")", style="bold blue")
            if lunch.lunch_time:
                header.append(f" [{lunch.lunch_time}]", style="dim cyan")
            console.print(header)

            if lunch.external_link:
                console.print(f"[green]→ {lunch.external_link}[/green]")
            else:
                for line in lunch.lines:
                    text = Text(f"• {line.dish}")
                    if line.price:
                        text.append(f" [{line.price}]", style="magenta")
                    text += sum(format_diet_tags(line.diet_tags), Text(""))
                    console.print(text)
            print(file=output)

def main():
    parser = argparse.ArgumentParser(description="Fetch Oulu lunches from lounaat.info")
    parser.add_argument("--max-distance", type=int, default=1500, help="Max distance in metres (default: 1500)")

    day_group = parser.add_mutually_exclusive_group()
    weekdays = ["monday", "tuesday", "wednesday", "thursday", "friday"]
    for i, day in enumerate(weekdays, start=1):
        day_group.add_argument(f"--{day}", f"--{day[:3]}", action="store_const", const=i, dest="weekday", help=f"Show {day.capitalize()}'s menu")

    args = parser.parse_args()

    lunches = fetch_lunch_items(args.max_distance, weekday=args.weekday)
    print_lunches(lunches, requested_weekday=args.weekday)

if __name__ == "__main__":
    main()
